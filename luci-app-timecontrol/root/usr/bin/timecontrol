#!/bin/sh
. /lib/functions.sh

CONF="timecontrol"
TIMECONTROL_ENABLE=0
TIMECONTROL_TYPE=0
IsUpdate=0
FW4=$(command -v fw4 2>/dev/null)
FW3_IP6=$(command -v ip6tables 2>/dev/null)
PIDFILE="/var/run/timecontrol.pid"
SLEEPTIME=60
RulesMACAddrList=""
DNSMASQ_CONF="/tmp/dnsmasq.d/timecontrol.conf"
DNSMASQ_TMP="/tmp/dnsmasq_timecontrol.new"

get_domain_list() {
	local rule_ids="$1"
	local all_domains=""
	for id in $rule_ids; do
		local domains=$(uci -q get "${CONF}.${id}.domains")
		domains=$(echo "$domains" | tr '\n' ' ')
		all_domains="$all_domains $domains"
	done
	echo "$all_domains"
}

create_sets() {
	local set_v4="$1"
	local set_v6="$2"

	if [ -z "$FW4" ]; then
		ipset -n list "$set_v4" >/dev/null 2>&1 || ipset create "$set_v4" hash:ip family inet
		ipset -n list "$set_v6" >/dev/null 2>&1 || ipset create "$set_v6" hash:ip family inet6
		ipset flush "$set_v4"
		ipset flush "$set_v6"
	else
		nft list set inet fw4 "$set_v4" >/dev/null 2>&1 || nft add set inet fw4 "$set_v4" { type ipv4_addr\; }
		nft list set inet fw4 "$set_v6" >/dev/null 2>&1 || nft add set inet fw4 "$set_v6" { type ipv6_addr\; }
		nft flush set inet fw4 "$set_v4"
		nft flush set inet fw4 "$set_v6"
	fi
}

generate_dnsmasq_entry() {
	local section="$1"
	local enable=$(config_n_get "$CONF" "$section" "enable" 0)
	local enable_domain=$(config_n_get "$CONF" "$section" "enable_domain" 0)

	if [ "$enable" -eq 1 ] && [ "$enable_domain" -eq 1 ]; then
		local domain_rules=$(config_n_get "$CONF" "$section" "domain_rules")
		local domains=$(get_domain_list "$domain_rules")

		if [ -n "$domains" ]; then
			local set_v4="tc_v4_$section"
			local set_v6="tc_v6_$section"
			create_sets "$set_v4" "$set_v6"

			if [ -z "$FW4" ]; then
				local set_str="$set_v4,$set_v6"
				for d in $domains; do
					if echo "$d" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
						ipset -q add "$set_v4" "$d"
					elif echo "$d" | grep -q ":"; then
						ipset -q add "$set_v6" "$d"
					else
						echo "ipset=/$d/$set_str" >> "$DNSMASQ_TMP"
					fi
				done
			else
				local set_str="4#inet#fw4#$set_v4,6#inet#fw4#$set_v6"
				for d in $domains; do
					if echo "$d" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
						nft add element inet fw4 "$set_v4" \{ "$d" \} 2>/dev/null
					elif echo "$d" | grep -q ":"; then
						nft add element inet fw4 "$set_v6" \{ "$d" \} 2>/dev/null
					else
						echo "nftset=/$d/$set_str" >> "$DNSMASQ_TMP"
					fi
				done
			fi
		fi
	fi
}

STATE_FILE="/var/run/timecontrol.state"

iptables_w() {
	iptables -w 1 "$@" >/dev/null 2>&1
	[ -n "$FW3_IP6" ] && ip6tables -w 1 "$@" >/dev/null 2>&1
}

# --- Accumulation Logic ---

init_accumulation_chains() {
	if [ -z "$FW4" ]; then
		# Create monitoring chain
		for table in filter; do
			for ipt in iptables ip6tables; do
				[ "$ipt" = "ip6tables" ] && [ -z "$FW3_IP6" ] && continue
				
				# Create timecontrol_check chain if not exists
				if ! $ipt -w 1 -t $table -L timecontrol_check >/dev/null 2>&1; then
					$ipt -w 1 -t $table -N timecontrol_check
				fi
				$ipt -w 1 -t $table -F timecontrol_check
				
				# Insert check chain at the beginning of FORWARD
				if ! $ipt -w 1 -t $table -C FORWARD -j timecontrol_check >/dev/null 2>&1; then
					$ipt -w 1 -t $table -I FORWARD 1 -j timecontrol_check
				fi
			done
		done
	else
		# FW4/NFT
		if ! nft list chain inet fw4 timecontrol_check >/dev/null 2>&1; then
			nft add chain inet fw4 timecontrol_check
		fi
		nft flush chain inet fw4 timecontrol_check
		
		# Insert check chain at the beginning of forward hook
		# We need to find the priority. Usually filter forward is 0. 
		# We want this to run before reject.
		# For simplicity, we can insert a jump rule in the 'forward' chain created by fw4
		if ! nft list chain inet fw4 forward | grep -q "jump timecontrol_check"; then
			nft insert rule inet fw4 forward counter jump timecontrol_check comment "!fw4: Time control check"
		fi
	fi
}

get_current_usage() {
	local id="$1"
	# Read from state file (simple key-value: ID=MINUTES)
	if [ -f "$STATE_FILE" ]; then
		grep "^$id=" "$STATE_FILE" | cut -d'=' -f2
	else
		echo "0"
	fi
}

set_usage() {
	local id="$1"
	local usage="$2"
	local today=$(date +%Y-%m-%d)
	
	# Create temp file
	local tmp_file="${STATE_FILE}.tmp"
	touch "$tmp_file"
	
	# If state file exists, check for date reset
	if [ -f "$STATE_FILE" ]; then
		local file_date=$(date -r "$STATE_FILE" +%Y-%m-%d)
		if [ "$today" != "$file_date" ]; then
			# New day, reset all usages (just start empty)
			: > "$tmp_file"
		else
			grep -v "^$id=" "$STATE_FILE" > "$tmp_file"
		fi
	fi
	
	echo "$id=$usage" >> "$tmp_file"
	mv "$tmp_file" "$STATE_FILE"
}

check_in_window() {
	local timerangelist="$1"
	local weekdays="$2"
	
	# Check Weekday
	if [ -n "$weekdays" ]; then
		local current_day=$(date +%A)
		if ! echo "$weekdays" | grep -q "$current_day"; then
			return 1 # Not in allowed day
		fi
	fi
	
	# Check Time Range
	if [ -z "$timerangelist" ]; then
		return 0 # No time limit means always allowed
	fi
	
	local current_time=$(date +%H%M)
	local in_range=1 # Default false (1)
	
	for timerange in $timerangelist; do
		local start=$(echo "$timerange" | awk -F '-' '{print $1}' | tr -d :)
		local end=$(echo "$timerange" | awk -F '-' '{print $2}' | tr -d :)
		# Handle hh:mm:ss -> hhmm
		start=${start:0:4}
		end=${end:0:4}
		
		if [ "$current_time" -ge "$start" ] && [ "$current_time" -le "$end" ]; then
			in_range=0 # True
			break
		fi
	done
	
	return $in_range
}

get_packet_count() {
	local id="$1"
	local mac="$2"
	local domain_set_v4="$3"
	
	# We use a unique comment/handle to find the rule
	# comment: "tc_monitor_$id"
	
	if [ -z "$FW4" ]; then
		# iptables: find rule in timecontrol_check with comment
		# We sum up packets from all rules for this ID (v4/v6/mac/ipset)
		iptables -w 1 -t filter -L timecontrol_check -v -n -x | grep "tc_monitor_$id" | awk '{s+=$1} END {print s}'
	else
		# nftables: find rule in timecontrol_check with comment
		nft list chain inet fw4 timecontrol_check | grep "tc_monitor_$id" | awk '{print $2}' | tr -d ' ' | paste -sd+ | bc
	fi
}

update_accumulation() {
	config_foreach check_accumulation_rule rule
}

check_accumulation_rule() {
	local section="$1"
	local enable=$(config_n_get "$CONF" "$section" "enable" 0)
	local mode=$(config_n_get "$CONF" "$section" "mode" "basic")
	local limit=$(config_n_get "$CONF" "$section" "limit_time" 60)
	local timerangelist=$(config_n_get "$CONF" "$section" "timerangelist")
	local weekdays=$(config_n_get "$CONF" "$section" "weekdays")
	local macaddrlist=$(config_n_get "$CONF" "$section" "macaddrlist")
	local enable_domain=$(config_n_get "$CONF" "$section" "enable_domain" 0)
	local domain_set_v4=""
	local domain_set_v6=""
	
	[ "$enable" -eq 1 ] && [ "$mode" = "accumulation" ] || return 0
	
	if [ "$enable_domain" -eq 1 ]; then
		domain_set_v4="tc_v4_$section"
		domain_set_v6="tc_v6_$section"
	fi

	# 1. Update Usage
	# Read previous packet count (stored in memory? no, we only have total packets since start)
	# Wait, we need "delta". But if we don't restart firewall, the counter increases.
	# We can store "last_packets" in a file too.
	
	local current_packets=$(get_packet_count "$section" "$macaddrlist" "$domain_set_v4")
	[ -z "$current_packets" ] && current_packets=0
	
	local last_packets_file="/tmp/timecontrol_${section}.pkts"
	local last_packets=0
	if [ -f "$last_packets_file" ]; then
		last_packets=$(cat "$last_packets_file")
	fi
	echo "$current_packets" > "$last_packets_file"
	
	# Calculate delta (handle restart where current < last)
	local delta=0
	if [ "$current_packets" -ge "$last_packets" ]; then
		delta=$((current_packets - last_packets))
	else
		delta="$current_packets"
	fi
	
	# If significant traffic (e.g. > 100 packets/min ~ 10KB), increment usage
	local current_usage=$(get_current_usage "$section")
	if [ "$delta" -gt 100 ]; then
		current_usage=$((current_usage + 1))
		set_usage "$section" "$current_usage"
	fi
	
	# 2. Check Logic (In Window AND Under Limit)
	local block_needed=0
	
	check_in_window "$timerangelist" "$weekdays"
	local in_window=$?
	
	if [ "$in_window" -ne 0 ]; then
		block_needed=1 # Outside Allowed Window -> Block
	elif [ "$current_usage" -ge "$limit" ]; then
		block_needed=1 # Over Limit -> Block
	fi
	
	# 3. Enforce State (Add/Remove Block Rule)
	# We use the standard set_Rules function but dynamically
	# We construct a unique comment for the block rule to identify it: "tc_block_$section"
	
	local rule_exists=0
	if [ -z "$FW4" ]; then
		if iptables -w 1 -t filter -C timecontrol_forward_reject -m comment --comment "tc_block_$section" -j REJECT 2>/dev/null; then
			rule_exists=1
		fi
	else
		if nft list chain inet fw4 timecontrol_forward_reject | grep -q "tc_block_$section"; then
			rule_exists=1
		fi
	fi
	
	if [ "$block_needed" -eq 1 ]; then
		if [ "$rule_exists" -eq 0 ]; then
			# Add Block Rule
			set_Rules "$macaddrlist" "" "" "$interface" "${CONF}_maclist_$section" 1 "$section" "$domain_set_v4" "$domain_set_v6" "tc_block_$section"
		fi
	else
		if [ "$rule_exists" -eq 1 ]; then
			# Remove Block Rule
			# We need to delete by comment.
			if [ -z "$FW4" ]; then
				# iptables delete by rule spec is hard if we don't have exact spec.
				# But set_Rules creates predictable rules.
				# Easier: Flush and rebuild? No.
				# Delete using loop until fail
				while iptables -w 1 -t filter -D timecontrol_forward_reject -m comment --comment "tc_block_$section" -j REJECT 2>/dev/null; do :; done
				[ -n "$FW3_IP6" ] && while ip6tables -w 1 -t filter -D timecontrol_forward_reject -m comment --comment "tc_block_$section" -j REJECT 2>/dev/null; do :; done
			else
				# nft delete by handle. Find handle by comment.
				handles=$(nft -a list chain inet fw4 timecontrol_forward_reject | grep "tc_block_$section" | awk '{print $NF}')
				for handle in $handles; do
					nft delete rule inet fw4 timecontrol_forward_reject handle $handle 2>/dev/null
				done
			fi
		fi
	fi
}

config_n_get() {
	local ret=$(uci -q get "${1}.${2}.${3}")
	echo "${ret:=$4}"
}

convert_timeToUTC() {
	local input_time="$1"
	local current_time=$(date +%Y-%m-%d)
	#local system_timezone=$(config_n_get "system" "@system[-1]" "timezone" "UTC")
	#local timestamp=$(TZ=$system_timezone date -d "$current_time $input_time" +%s 2>/dev/null)
	local timestamp=$(date -d "$current_time $input_time" +%s 2>/dev/null)
	local utc_time=$(TZ=UTC date -d @$timestamp +%H:%M:%S)
	echo $utc_time
}

get_UTC_timerange() {
	start_time=$(echo "$1" | awk -F '-' '{print $1}')
	end_time=$(echo "$1" | awk -F '-' '{print $2}')
	start_utctime=$(convert_timeToUTC "$start_time")
	end_utctime=$(convert_timeToUTC "$end_time")

	if [ "$(date -d "$end_utctime" +%s)" -lt "$(date -d "$start_utctime" +%s)" ]; then
		if [ "$end_utctime" == "00:00:00" ]; then
			echo \"${start_utctime}\"-\"23:59:59\"
		else
			echo \"${start_utctime}\"-\"23:59:59\",\"00:00:00\"-\"${end_utctime}\"
		fi
	else
		echo \"${start_utctime}\"-\"${end_utctime}\"
	fi
}

load_config() {
	config_load "$CONF"
	TIMECONTROL_ENABLE=$(config_n_get "$CONF" "config" "enable" 0)
	TIMECONTROL_TYPE=$(config_n_get "$CONF" "config" "controlType" 0)

	if [ $TIMECONTROL_ENABLE -ne 1 ]; then
		logger -t timecontrol "timecontrol is disabled, exiting."
		exit 0
	fi
}

set_Rules() {
	local macaddrlist=$1
	local timerangelist=$2
	local days=$3
	local interfacelist=$4
	local ipsetname=$5
	local matchflag=$6 # 0: not match, 1: match
	local id=$7
	local domain_set_v4=$8
	local domain_set_v6=$9
	local comment_tag=${10} # Optional comment override

	if [ -z "$comment_tag" ]; then
		comment_tag="!fw3: Time control"
		# For nft, it was "!fw4: Time control"
		if [ -n "$FW4" ]; then
			comment_tag="!fw4: Time control"
		fi
	fi

	if [ -z "$FW4" ]; then
		local ether_saddr_param
		if [ -n "$macaddrlist" ]; then
			ipset create "$ipsetname" hash:mac
			for macaddr in $macaddrlist; do
				ipset add "$ipsetname" $macaddr
			done
			local match_param
			if [ $matchflag -eq 0 ]; then
				match_param="!"
			fi
			ether_saddr_param="-m set $match_param --match-set $ipsetname src"
		fi

		local weekdays_param
		if [ -n "$days" ]; then
			weekdays_param="--weekdays "$days""
		fi

		# If timerangelist is empty, and we are not in accumulation mode call (which passes empty ranges for block rule),
		# then default to all day.
		# But here, if timerangelist is empty, loop below runs once with empty string, setting empty time_param.
		# This is correct.

		if [ -z "$timerangelist" ]; then
			timerangelist="00:00:00-23:59:59"
		fi

		for timerange in $timerangelist; do
			timeon=$(echo "$timerange" | awk -F '-' '{print $1}')
			timeoff=$(echo "$timerange" | awk -F '-' '{print $2}')

			local time_param
			if [ -n "$timeon" ] && [ -n "$timeoff" ]; then
				time_param="--timestart $timeon --timestop $timeoff"
			fi

			local chain target
			for table in filter nat; do
				case $table in
				filter)
					chain="timecontrol_forward_reject"
					target="reject"
					;;
				nat)
					chain="timecontrol_dstnat_accept"
					target="ACCEPT"
					;;
				*) ;;
				esac
				
				local dst_v4_param=""
				local dst_v6_param=""
				if [ -n "$domain_set_v4" ]; then
					dst_v4_param="-m set --match-set $domain_set_v4 dst"
					dst_v6_param="-m set --match-set $domain_set_v6 dst"
				fi

				if [ -n "$interfacelist" ]; then
					for interface in $interfacelist; do
						iifname_param="-i ${interface}"
						iptables -w 1 -t $table -A $chain $iifname_param $ether_saddr_param $dst_v4_param -m time --kerneltz $time_param $weekdays_param -j $target -m comment --comment "$comment_tag"
						[ -n "$FW3_IP6" ] && ip6tables -w 1 -t $table -A $chain $iifname_param $ether_saddr_param $dst_v6_param -m time --kerneltz $time_param $weekdays_param -j $target -m comment --comment "$comment_tag"
					done
				else
					iptables -w 1 -t $table -A $chain $ether_saddr_param $dst_v4_param -m time --kerneltz $time_param $weekdays_param -j $target -m comment --comment "$comment_tag"
					[ -n "$FW3_IP6" ] && ip6tables -w 1 -t $table -A $chain $ether_saddr_param $dst_v6_param -m time --kerneltz $time_param $weekdays_param -j $target -m comment --comment "$comment_tag"
				fi
			done
		done

	else
		local ether_saddr_param
		if [ -n "$macaddrlist" ]; then
			macaddr=$(echo $macaddrlist | sed 's/ /,/g')
			local match_param
			if [ $matchflag -eq 0 ]; then
				match_param="!="
			fi
			ether_saddr_param="ether saddr $match_param { ${macaddr} } "
		fi

		local meta_hour_param
		if [ -n "$timerangelist" ]; then
			local utc_timeranges
			for timerange in $timerangelist; do
				if [ -z "$utc_timeranges" ]; then
					utc_timeranges="$(get_UTC_timerange "$timerange")"
				else
					utc_timeranges="${utc_timeranges},$(get_UTC_timerange "$timerange")"
				fi
			done
			meta_hour_param="meta hour { ${utc_timeranges} } "
		fi

		local meta_day_param
		if [ -n "$days" ]; then
			meta_day_param="meta day { ${days} } "
		fi

		local iifname_param
		if [ -n "$interfacelist" ]; then
			local interface=\"$(echo $interfacelist | sed 's/ /","/g')\"
			iifname_param="iifname { ${interface} } "
		fi
		
		if [ -n "$domain_set_v4" ]; then
			# Domain restriction enabled: specific rules for v4 and v6
			TZ=UTC nft "add rule inet fw4 timecontrol_forward_reject ${ether_saddr_param} ip daddr @$domain_set_v4 ${meta_hour_param} ${meta_day_param} ${iifname_param} counter jump handle_reject comment \"$comment_tag\""
			TZ=UTC nft "add rule inet fw4 timecontrol_forward_reject ${ether_saddr_param} ip6 daddr @$domain_set_v6 ${meta_hour_param} ${meta_day_param} ${iifname_param} counter jump handle_reject comment \"$comment_tag\""
			
			TZ=UTC nft "add rule inet fw4 timecontrol_dstnat_accept ${ether_saddr_param} ip daddr @$domain_set_v4 ${meta_hour_param} ${meta_day_param} ${iifname_param} counter accept comment \"$comment_tag\""
			TZ=UTC nft "add rule inet fw4 timecontrol_dstnat_accept ${ether_saddr_param} ip6 daddr @$domain_set_v6 ${meta_hour_param} ${meta_day_param} ${iifname_param} counter accept comment \"$comment_tag\""
		else
			# Standard behavior
			TZ=UTC nft "add rule inet fw4 timecontrol_forward_reject ${ether_saddr_param} ${meta_hour_param} ${meta_day_param} ${iifname_param} counter jump handle_reject comment \"$comment_tag\""
			TZ=UTC nft "add rule inet fw4 timecontrol_dstnat_accept ${ether_saddr_param} ${meta_hour_param} ${meta_day_param} ${iifname_param} counter accept comment \"$comment_tag\""
		fi
	fi

	local log_MAC="MAC: AllClients;"
	if [ -n "$macaddrlist" ]; then
		log_MAC="MAC: $(echo $macaddrlist | sed 's/ /,/g'); "
	fi

	local log_timeranges="Time: AnyTime; "
	if [ -n "$timerangelist" ]; then
		log_timeranges="Time: $(echo $timerangelist | sed 's/ /,/g'); "
	fi

	local log_weekdays="Weekdays: AnyDay; "
	if [ -n "$days" ]; then
		log_weekdays="Weekdays: $(echo $days | sed 's/ /,/g'); "
	fi

	local log_interface="Interface: *"
	if [ -n "$interfacelist" ]; then
		log_interface="Interface: $(echo $interfacelist | sed 's/ /,/g')"
	fi

	local log_id
	if [ -n "$id" ]; then
		log_id="ID: $id; "
	fi

	logger -t timecontrol "added rule (${log_id}${log_MAC}${log_timeranges}${log_weekdays}${log_interface})"
}

delete_conntrack() {
	local macaddrlist=$1
	local interfacelist=$2
	local matchflag=$3 # 0: not match, 1: match

	if [ -n "$(command -v conntrack 2>/dev/null)" ]; then
		local match_param
		if [ $matchflag -eq 0 ]; then
			match_param="-v"
		fi

		mac_regex=$(echo ${macaddrlist} | sed 's/ /|/g')
		interface_regex=$(echo ${interfacelist} | sed 's/ /|/g')

		ipaddr_list=$(ip neigh | grep -i -E "${mac_regex}" $match_param | grep -i -E "${interface_regex}" | awk '{print $1}')
		for ipaddr in $ipaddr_list; do
			conntrack -D --orig-src "$ipaddr" >/dev/null 2>&1
		done

		if [ -n "$ipaddr_list" ]; then
			logger -t timecontrol "deleted conntrack entries for IPs: $(echo $ipaddr_list | sed 's/ /,/g')"
		fi
	fi
}

add_controlRules() {
	local enable=$(config_n_get "$CONF" "$1" "enable" 0)
	local macaddrlist=$(config_n_get "$CONF" "$1" "macaddrlist")
	local timerangelist=$(config_n_get "$CONF" "$1" "timerangelist")
	local weekdays=$(config_n_get "$CONF" "$1" "weekdays")
	local temporaryControl=$(config_n_get "$CONF" "$1" "temporaryControl" 0)
	local temporaryDuration=$(config_n_get "$CONF" "$1" "temporaryDuration" 0)
	local interface=$(config_n_get "$CONF" "$1" "interface")
	local enable_domain=$(config_n_get "$CONF" "$1" "enable_domain" 0)
	local mode=$(config_n_get "$CONF" "$1" "mode" "basic")

	if [ $enable -ne 1 ]; then
		return 0
	fi

	if [ -n "$macaddrlist" ]; then
		if [ -z "$RulesMACAddrList" ]; then
			RulesMACAddrList="$macaddrlist"
		else
			RulesMACAddrList="$RulesMACAddrList $macaddrlist"
		fi
	fi

	#temporary unblock
	if [ $temporaryDuration -gt 0 ] && [ $temporaryControl -eq 0 ]; then
		logger -t timecontrol "temporary unblock $temporaryDuration minutes (ID: $1)"
		return 0
	fi

	weekdays=$(echo "$weekdays" | sed 's/ /,/g')
	local days
	if [ "$weekdays" != "Sunday,Monday,Tuesday,Wednesday,Thursday,Friday,Saturday" ]; then
		days="$weekdays"
	fi

	#blacklist with no time and day limit
	if [ $TIMECONTROL_TYPE -ne 0 ] && [ -z "$timerangelist" ] && [ -z "$days" ] && [ $temporaryDuration -eq 0 ] && [ "$mode" = "basic" ]; then
		return 0
	fi
	
	local domain_set_v4=""
	local domain_set_v6=""
	if [ "$enable_domain" -eq 1 ]; then
		domain_set_v4="tc_v4_$1"
		domain_set_v6="tc_v6_$1"
	fi

	#temporary block
	if [ $temporaryDuration -gt 0 ] && [ $temporaryControl -eq 1 ]; then
		days=""
		timerangelist="00:00:00-23:59:59"
		logger -t timecontrol "temporary block $temporaryDuration minutes (ID: $1)"
	fi
	
	if [ "$mode" = "accumulation" ]; then
		# In Accumulation Mode:
		# 1. We don't add the standard Block Rule here (it's managed dynamically in the loop).
		# 2. We DO add a "Monitor Rule" to the monitoring chain to count packets.
		
		# Create Monitor Rule (Accept/Return/Continue)
		if [ -z "$FW4" ]; then
			local ether_saddr_param
			local dst_v4_param=""
			local dst_v6_param=""
			
			# Create ipset if needed (usually done in set_Rules, but we need it here)
			local ipsetname="${CONF}_maclist_$1"
			if [ -n "$macaddrlist" ]; then
				ipset create "$ipsetname" hash:mac -exist
				for macaddr in $macaddrlist; do
					ipset add "$ipsetname" $macaddr -exist
				done
				ether_saddr_param="-m set --match-set $ipsetname src"
			fi
			
			if [ -n "$domain_set_v4" ]; then
				dst_v4_param="-m set --match-set $domain_set_v4 dst"
				dst_v6_param="-m set --match-set $domain_set_v6 dst"
			fi
			
			# Add to check chain
			iptables -w 1 -t filter -A timecontrol_check $ether_saddr_param $dst_v4_param -j RETURN -m comment --comment "tc_monitor_$1"
			[ -n "$FW3_IP6" ] && ip6tables -w 1 -t filter -A timecontrol_check $ether_saddr_param $dst_v6_param -j RETURN -m comment --comment "tc_monitor_$1"
			
		else
			# NFT Monitor Rule
			local ether_saddr_param
			if [ -n "$macaddrlist" ]; then
				local macaddr=$(echo $macaddrlist | sed 's/ /,/g')
				ether_saddr_param="ether saddr { ${macaddr} } "
			fi
			
			if [ -n "$domain_set_v4" ]; then
				nft add rule inet fw4 timecontrol_check ${ether_saddr_param} ip daddr @$domain_set_v4 counter return comment \"tc_monitor_$1\"
				nft add rule inet fw4 timecontrol_check ${ether_saddr_param} ip6 daddr @$domain_set_v6 counter return comment \"tc_monitor_$1\"
			else
				nft add rule inet fw4 timecontrol_check ${ether_saddr_param} counter return comment \"tc_monitor_$1\"
			fi
		fi
		
		logger -t timecontrol "added monitor rule for accumulation (ID: $1)"
		
	else
		# Basic Mode
		set_Rules "$macaddrlist" "$timerangelist" "$days" "$interface" "${CONF}_maclist_$1" 1 "$1" "$domain_set_v4" "$domain_set_v6"
	fi
	
	delete_conntrack "$macaddrlist" "$interface" 1
}

add_rejectRule() {
	local rejectInterface=$(config_n_get "$CONF" "config" "rejectInterface")
	local timerangelist=$(config_n_get "$CONF" "config" "timerangelist")
	local weekdays=$(config_n_get "$CONF" "config" "weekdays")

	if [ -n "$RulesMACAddrList" ]; then
		RulesMACAddrList=$(echo $RulesMACAddrList | tr ' ' '\n' | awk '!a[$0]++' | tr '\n' ' ')
	fi

	weekdays=$(echo "$weekdays" | sed 's/ /,/g')
	local days
	if [ "$weekdays" != "Sunday,Monday,Tuesday,Wednesday,Thursday,Friday,Saturday" ]; then
		days="$weekdays"
	fi

	set_Rules "$RulesMACAddrList" "$timerangelist" "$days" "$rejectInterface" "${CONF}_maclist" 0
	delete_conntrack "$RulesMACAddrList" "$rejectInterface" 0
}

cleanup_ipset() {
	nameList=$(ipset list -name | grep "${CONF}_maclist")
	for name in $nameList; do
		ipset destroy $name 2>/dev/null
	done
}

Initialize() {
	logger -t timecontrol ""$1"ing"
	load_config

	# Prepare DNSMASQ
	mkdir -p "$(dirname "$DNSMASQ_CONF")"
	: > "$DNSMASQ_TMP"
	config_foreach generate_dnsmasq_entry rule

	if [ -f "$DNSMASQ_CONF" ]; then
		diff "$DNSMASQ_CONF" "$DNSMASQ_TMP" >/dev/null
		if [ $? -ne 0 ]; then
			mv "$DNSMASQ_TMP" "$DNSMASQ_CONF"
			/etc/init.d/dnsmasq reload
			logger -t timecontrol "reloaded dnsmasq"
		else
			rm "$DNSMASQ_TMP"
		fi
	else
		if [ -s "$DNSMASQ_TMP" ]; then
			mv "$DNSMASQ_TMP" "$DNSMASQ_CONF"
			/etc/init.d/dnsmasq reload
			logger -t timecontrol "reloaded dnsmasq"
		else
			rm "$DNSMASQ_TMP"
		fi
	fi
	
	init_accumulation_chains

	if [ -z "$FW4" ]; then
		set_iptablesChains
		set_iptablesRules
		cleanup_ipset
	else
		set_nftablesChains
		set_nftablesRules
	fi

	RulesMACAddrList=""

	config_foreach add_controlRules rule

	local controltype="blacklist"
	if [ $TIMECONTROL_TYPE -ne 0 ]; then
		add_rejectRule
		controltype="whitelist"
	fi

	logger -t timecontrol "control type --> $controltype"
	logger -t timecontrol ""$1"ed"
}

set_nftablesChains() {
	if nft list chain inet fw4 timecontrol_forward_reject >/dev/null 2>&1; then
		nft flush chain inet fw4 timecontrol_forward_reject
	else
		nft add chain inet fw4 timecontrol_forward_reject
	fi

	if nft list chain inet fw4 timecontrol_dstnat_accept >/dev/null 2>&1; then
		nft flush chain inet fw4 timecontrol_dstnat_accept
	else
		nft add chain inet fw4 timecontrol_dstnat_accept
	fi
}

set_nftablesRules() {

	for chain in forward dstnat; do
		local jumpChain
		case $chain in
		forward)
			jumpChain="timecontrol_forward_reject"
			;;
		dstnat)
			jumpChain="timecontrol_dstnat_accept"
			;;
		*) ;;
		esac

		first_rule=$(nft list chain inet fw4 $chain | sed -n '4p' | grep -E "$jumpChain")
		if [ -z "$first_rule" ]; then
			handles=$(nft -a list chain inet fw4 $chain | grep "$jumpChain" | awk '{print $NF}')
			for handle in $handles; do
				nft delete rule inet fw4 $chain handle $handle 2>/dev/null
			done
			nft "insert rule inet fw4 $chain counter jump "$jumpChain" comment \"!fw4: Time control\" " 2>/dev/null
			logger -t timecontrol "set rule position to first (chain: $chain)"
		fi
	done
}

set_iptablesChains() {
	local jumpChain
	for table in filter nat; do
		case $table in
		filter)
			jumpChain="timecontrol_forward_reject"
			;;
		nat)
			jumpChain="timecontrol_dstnat_accept"
			;;
		*) ;;
		esac
		for ipt in iptables ip6tables; do
			case $ipt in
			ip6tables)
				if [ -z "$FW3_IP6" ]; then
					continue
				fi
				;;
			*) ;;
			esac

			if $ipt -w 1 -t $table -L $jumpChain >/dev/null 2>&1; then
				$ipt -w 1 -t $table -F $jumpChain
			else
				$ipt -w 1 -t $table -N $jumpChain
				$ipt -w 1 -t $table -F $jumpChain
			fi
		done
	done
}

set_iptablesRules() {
	local chain jumpChain
	for table in filter nat; do
		case $table in
		filter)
			chain="FORWARD"
			jumpChain="timecontrol_forward_reject"
			;;
		nat)
			chain="PREROUTING"
			jumpChain="timecontrol_dstnat_accept"
			;;
		*) ;;
		esac
		for ipt in iptables ip6tables; do
			case $ipt in
			ip6tables)
				if [ -z "$FW3_IP6" ]; then
					continue
				fi
				;;
			*) ;;
			esac

			first_rule=$($ipt -w 1 -t $table -S $chain | sed -n '2p')
			echo "$first_rule" | grep -q $jumpChain
			if [ $? -ne 0 ]; then
				while $ipt -w 1 -t $table -C $chain -j $jumpChain 2>/dev/null; do
					$ipt -w 1 -t $table -D $chain -j $jumpChain 2>/dev/null
				done
				$ipt -w 1 -t $table -I $chain -j $jumpChain 2>/dev/null
				logger -t timecontrol "set rule position to first (cmd: $ipt, table: $table, chain: $chain)"
			fi
		done
	done
}

update_ruleTemporaryDuration() {
	local enable=$(config_n_get "$CONF" "$1" "enable" 0)
	local temporaryDuration=$(config_n_get "$CONF" "$1" "temporaryDuration" 0)

	if [ $temporaryDuration -le 0 ]; then
		return
	fi

	temporaryDuration=$(expr $temporaryDuration - 1)

	if [ $temporaryDuration -eq 0 ]; then
		IsUpdate=1
		uci -q delete timecontrol.$1.temporaryDuration
	else
		uci -q set timecontrol.$1.temporaryDuration=$temporaryDuration
	fi
	uci -q commit timecontrol

	logger -t timecontrol "updated rule's temporary duration to $temporaryDuration (ID: $1)"
}

update_temporaryDuration() {
	IsUpdate=0

	load_config
	config_foreach update_ruleTemporaryDuration rule

	if [ $IsUpdate -eq 1 ]; then
		Initialize flush
	fi
}

check_firstRule() {
	if [ -z "$FW4" ]; then
		set_iptablesRules
	else
		set_nftablesRules
	fi
}

reset_sleep_time() {
	SLEEPTIME=60
	logger -t timecontrol "reset sleep time"
}

start() {
	if [ -f "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE" 2>/dev/null)
		if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
			rm -f "$PIDFILE" >/dev/null 2>&1
		fi
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ "$pid" -ne $$ ]; then
			logger -t timecontrol "already running"
			echo "timecontrol is already running"
			return 0
		fi
	fi

	echo $$ >"$PIDFILE"
	trap reset_sleep_time USR1
	trap stop SIGHUP SIGINT SIGQUIT SIGTERM EXIT

	Initialize start
	while true; do
		while [ $SLEEPTIME -gt 0 ]; do
			sleep 3
			SLEEPTIME=$(expr $SLEEPTIME - 3)
		done
		SLEEPTIME=60
		update_temporaryDuration
		update_accumulation
		check_firstRule
	done
}

stop() {
	logger -t timecontrol "stopping"

	if [ -z "$FW4" ]; then
		local chain jumpChain
		for table in filter nat; do
			case $table in
			filter)
				chain="FORWARD"
				jumpChain="timecontrol_forward_reject"
				;;
			nat)
				chain="PREROUTING"
				jumpChain="timecontrol_dstnat_accept"
				;;
			*) ;;
			esac
			for ipt in iptables ip6tables; do
				while $ipt -w 1 -t $table -C $chain -j $jumpChain 2>/dev/null; do
					$ipt -w 1 -t $table -D $chain -j $jumpChain 2>/dev/null
				done
			done
			iptables_w -t $table -F $jumpChain
			iptables_w -t $table -X $jumpChain
		done
		cleanup_ipset
	else
		for chain in forward dstnat; do
			local jumpChain
			case $chain in
			forward)
				jumpChain="timecontrol_forward_reject"
				;;
			dstnat)
				jumpChain="timecontrol_dstnat_accept"
				;;
			*) ;;
			esac
			rule_handles=$(nft -a list chain inet fw4 $chain | grep "$jumpChain" | awk '{print $NF}')
			for handle in $rule_handles; do
				nft delete rule inet fw4 $chain handle $handle >/dev/null 2>&1
			done
		done
		nft delete chain inet fw4 timecontrol_forward_reject >/dev/null 2>&1
		nft delete chain inet fw4 timecontrol_dstnat_accept >/dev/null 2>&1
	fi
	logger -t timecontrol "stopped"

	if [ "$(service timecontrol status)" != "running" ]; then
		if [ -f "$PIDFILE" ]; then
			rm -f "$PIDFILE" >/dev/null 2>&1
		fi
	fi
	trap - SIGHUP SIGINT SIGQUIT SIGTERM EXIT USR1
	logger -t timecontrol "cleanup done"

	exit 0
}

case "$1" in
stop)
	if [ -f "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE" 2>/dev/null)
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			kill -SIGTERM "$pid" 2>/dev/null
		else
			stop
		fi
	else
		stop
	fi
	;;
flush)
	if [ -f "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE" 2>/dev/null)
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			kill -USR1 "$pid" 2>/dev/null
		fi
	fi
	Initialize flush
	;;
*)
	start
	;;
esac
